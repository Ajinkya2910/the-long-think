# Copy to .env (never commit it).
ANTHROPIC_API_KEY=        # optional; without it narratives use the deterministic template
YOUTUBE_API_KEY=          # optional; enables YouTube crowd mood (Google Cloud > YouTube Data API v3)
LICHESS_TOKEN=            # optional; only needed if the explorer starts requiring auth
STOCKFISH_PATH=           # optional; defaults to `stockfish` on PATH
ENGINE_DEPTH=             # optional override of config.toml [engine].depth
